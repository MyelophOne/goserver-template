# Version control
.git/
.github/
.gitignore

# Environment files and local secrets
.env
.env.*

# Go workspaces, caches, and build artifacts
go.work
go.work.sum
vendor/
tmp/
bin/
build/
dist/
.cache/
.gocache/
coverage/
coverage.out
coverage.html
*.test
*.exe
*.out
*.prof
*.pprof
*.trace

# Runtime and tool logs
logs/
*.log
build-errors.log

# Local development configuration
.devcontainer/
.vscode/
.idea/
.air.toml
.golangci.yml
.editorconfig
taskfile.yml

# Docker development files are not needed inside the image
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Repository documentation not used at runtime
README.md
templates/_examples.md

# Optional frontend artifacts in a combined repository
node_modules/
.nuxt/
.output/
.pnp/
.pnp.js
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating-system and language tooling artifacts
.DS_Store
Thumbs.db
__pycache__/
*.pyc
